<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f74a22c6-ce10-4c83-9ae5-57550befa229</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.100" />
    <PackageReference Include="dbup-mysql" Version="6.1.0" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migreringsskript som DbUp läser ur assemblyn -->
    <EmbeddedResource Include="Data\Migrations\*.sql" />
  </ItemGroup>

</Project>
